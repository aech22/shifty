{
  "rules": {
    "global": {
      "shops": { ".read": true, ".write": true },
      "templates": { ".read": true, ".write": true }
    },
    "shops": {
      "$shopId": {
        ".read": true,
        ".write": true,
        "subs": {
          "$subId": {
            ".validate": "newData.hasChildren(['id','staffName','periodId','shifts','submittedAt'])"
          }
        }
      }
    },
    "accounts": {
      "$uid": {
        "plan":             { ".read": true,  ".write": false },
        "planExpiry":       { ".read": true,  ".write": false },
        "stripeCustomerId": { ".read": false, ".write": false },
        "shops": {
          ".read": "auth != null",
          ".write": "auth != null"
        },
        "inviteCode": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "members": {
          ".read": "auth != null && auth.uid === $uid",
          "$memberId": {
            ".write": "auth != null"
          }
        }
      }
    },
    "pendingLinks": {
      "$userId": {
        ".read": "auth != null && auth.uid === $userId",
        ".write": "auth != null && auth.uid === $userId"
      }
    }
  }
}
