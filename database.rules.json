{
  "rules": {
    "global": {
      "shops": {
        "$shopId": {
          ".read": "auth != null",
          ".write": "auth != null && newData.exists() && newData.child('id').val() === $shopId && (!root.child('shops').child($shopId).child('owners').exists() || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())",
          ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 100"
        }
      }
    },
    "tokens": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && (!data.exists() || newData.child('shopId').val() === data.child('shopId').val()) && (!root.child('shops').child(newData.child('shopId').val()).child('owners').exists() || root.child('shops').child(newData.child('shopId').val()).child('owners').child(auth.uid).exists())) || (!newData.exists() && data.exists() && (!root.child('shops').child(data.child('shopId').val()).child('owners').exists() || root.child('shops').child(data.child('shopId').val()).child('owners').child(auth.uid).exists())))",
        ".validate": "newData.hasChildren(['shopId','periodId'])"
      }
    },
    "shops": {
      "$shopId": {
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && (!root.child('shops').child($shopId).child('owners').exists() || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())"
        },
        "periods": {
          ".read": "auth != null",
          ".write": "auth != null && (!root.child('shops').child($shopId).child('owners').exists() || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())",
          "$periodId": {
            ".validate": "newData.hasChildren(['id'])"
          }
        },
        "staff": {
          ".read": "auth != null",
          ".write": "auth != null && (!root.child('shops').child($shopId).child('owners').exists() || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())",
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          }
        },
        "templates": {
          ".read": "auth != null",
          ".write": "auth != null && (!root.child('shops').child($shopId).child('owners').exists() || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())"
        },
        "lastActivity": {
          ".read": "auth != null",
          ".write": "auth != null",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "subs": {
          ".read": "auth != null",
          ".indexOn": ["periodId"],
          "$subId": {
            ".write": "auth != null",
            ".validate": "newData.hasChildren(['id','staffName','periodId','shifts','submittedAt']) && newData.child('staffName').isString() && newData.child('staffName').val().length <= 50"
          }
        },
        "owners": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && newData.isString() && newData.val() === root.child('shops').child($shopId).child('private').child('adminKey').val()"
          }
        },
        "private": {
          ".read": "auth != null && (!root.child('shops').child($shopId).child('owners').exists() || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())",
          "adminKey": {
            ".write": "auth != null && (!data.exists() || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())",
            ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
          }
        }
      }
    },
    "accounts": {
      "$uid": {
        "plan":             { ".read": "auth != null",  ".write": false },
        "planExpiry":       { ".read": "auth != null",  ".write": false },
        "paymentFailed":    { ".read": "auth != null",  ".write": false },
        "stripeCustomerId": { ".read": false, ".write": false },
        "shops": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "inviteCode": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "company": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        },
        "members": {
          ".read": "auth != null && auth.uid === $uid",
          "$memberId": {
            ".write": "auth != null && auth.uid === $memberId"
          }
        }
      }
    },
    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['uid','expiresAt'])"
      }
    },
    "companies": {
      "$companyId": {
        ".write": false,
        "pub": {
          ".read": "auth != null && (auth.uid === 'company_' + $companyId || data.child('ownerUid').val() === auth.uid)"
        },
        "private": { ".read": false, ".write": false }
      }
    },
    "companyCodes": { ".read": false, ".write": false }
  }
}
