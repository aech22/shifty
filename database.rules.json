{
  "rules": {
    "global": {
      "shops": {
        "$shopId": {
          ".read": "auth != null",
          ".write": "auth != null && newData.exists() && newData.child('id').val() === $shopId && (!data.exists() || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())",
          ".validate": "newData.child('name').isString() && newData.child('name').val().length <= 100"
        }
      }
    },
    "tokens": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && (!data.exists() || newData.child('shopId').val() === data.child('shopId').val()) && root.child('shops').child(newData.child('shopId').val()).child('owners').child(auth.uid).exists()) || (!newData.exists() && data.exists() && root.child('shops').child(data.child('shopId').val()).child('owners').child(auth.uid).exists()))",
        ".validate": "newData.hasChildren(['shopId','periodId'])"
      }
    },
    "shops": {
      "$shopId": {
        "settings": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()"
        },
        "periods": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          "$periodId": {
            ".validate": "newData.hasChildren(['id'])"
          }
        },
        "staff": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          "$i": {
            ".validate": "newData.isString() && newData.val().length <= 50"
          }
        },
        "templates": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()"
        },
        "lastActivity": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          ".validate": "newData.isString() && newData.val().length <= 40"
        },
        "company": {
          ".read": "auth != null",
          ".write": false
        },
        "subs": {
          ".read": "auth != null",
          ".indexOn": ["periodId"],
          "$subId": {
            ".write": "auth != null && $shopId !== 'demo-toriMatsu-v1' && (root.child('shops').child($shopId).child('owners').child(auth.uid).exists() || ((!newData.exists() || !root.child('shops').child($shopId).child('periods').child(newData.child('periodId').val()).child('confirmation').exists()) && (!data.exists() || !root.child('shops').child($shopId).child('periods').child(data.child('periodId').val()).child('confirmation').exists())))",
            ".validate": "newData.hasChildren(['id','staffName','periodId','shifts','submittedAt']) && newData.child('staffName').isString() && newData.child('staffName').val().length <= 50",
            "submitterUid": {
              ".validate": "newData.isString() && newData.val().length <= 128 && (newData.val() === auth.uid || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())"
            }
          }
        },
        "laborMonths": {
          ".read": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          ".write": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          "$ym": {
            ".validate": "$ym.matches(/^[0-9]{4}-(0[1-9]|1[0-2])$/)",
            "$name": {
              ".validate": "newData.hasChildren(['days','min']) && newData.child('days').isNumber() && newData.child('days').val() >= 0 && newData.child('min').isNumber() && newData.child('min').val() >= 0"
            }
          }
        },
        "actuals": {
          ".read": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          ".write": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          "$periodId": {
            "$name": {
              ".validate": "$name.length <= 50",
              "$date": {
                ".validate": "$date.matches(/^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && newData.hasChildren()",
                "start": { ".validate": "newData.isString() && newData.val().matches(/^([0-2][0-9]|30):[0-5][0-9]$/)" },
                "end": { ".validate": "newData.isString() && newData.val().matches(/^([0-2][0-9]|30):[0-5][0-9]$/)" },
                "breakMin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
                "absent": { ".validate": "newData.isBoolean()" },
                "absentMin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
                "legalHoliday": { ".validate": "newData.isBoolean()" },
                "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
                "$other": { ".validate": false }
              }
            }
          }
        },
        "linkRequests": {
          ".read": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && $shopId !== 'demo-toriMatsu-v1' && ((auth.uid === $uid && auth.token.email != null && root.child('global').child('shops').child($shopId).exists()) || (!newData.exists() && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['displayName','at'])",
            "displayName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
            "number": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
            "at": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },
        "staffLinks": {
          ".read": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && !newData.exists() && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['name','method','at'])",
            "name": {
              ".write": "auth != null && data.exists() && newData.exists() && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50"
            },
            "personId": { ".validate": "newData.isString() && newData.val().length <= 64" },
            "method": { ".validate": "newData.val() === 'number' || newData.val() === 'name' || newData.val() === 'code' || newData.val() === 'page'" },
            "at": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },
        "staffPages": {
          ".read": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          "$token": {
            ".read": "auth != null",
            ".write": "auth != null && $shopId !== 'demo-toriMatsu-v1' && (root.child('shops').child($shopId).child('owners').child(auth.uid).exists() || (!data.exists() && newData.child('status').val() === 'pending' && root.child('global').child('shops').child($shopId).exists()) || (data.child('status').val() === 'pending' && !newData.exists()))",
            ".validate": "$token.matches(/^[A-Za-z0-9]{24}$/) && newData.hasChildren(['status','displayName','requestedAt']) && (newData.child('status').val() !== 'approved' || newData.hasChildren(['name','approvedAt']))",
            "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected' || newData.val() === 'revoked'" },
            "displayName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
            "number": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
            "requestedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "name": { ".validate": "root.child('shops').child($shopId).child('owners').child(auth.uid).exists() && newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
            "approvedAt": { ".validate": "root.child('shops').child($shopId).child('owners').child(auth.uid).exists() && newData.isString() && newData.val().length <= 40" },
            "byUid": { ".validate": "root.child('shops').child($shopId).child('owners').child(auth.uid).exists() && newData.val() === auth.uid" },
            "revokedAt": { ".validate": "root.child('shops').child($shopId).child('owners').child(auth.uid).exists() && newData.isString() && newData.val().length <= 40" },
            "pinResetAt": { ".validate": "root.child('shops').child($shopId).child('owners').child(auth.uid).exists() && newData.isString() && newData.val().length <= 40" },
            "$other": { ".validate": false }
          }
        },
        "owners": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && newData.isString() && newData.val() === root.child('shops').child($shopId).child('private').child('adminKey').val()) || (!newData.exists() && data.parent().child(auth.uid).exists()))"
          }
        },
        "private": {
          ".read": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
          "adminKey": {
            ".write": "auth != null && (!data.exists() || root.child('shops').child($shopId).child('owners').child(auth.uid).exists())",
            ".validate": "newData.isString() && newData.val().length >= 16 && newData.val().length <= 64"
          },
          "pay": {
            ".write": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
            "$name": {
              ".validate": "newData.hasChildren(['payType','base']) && (newData.child('payType').val() === 'monthly' || newData.child('payType').val() === 'hourly') && newData.child('base').isNumber() && newData.child('base').val() >= 0"
            }
          },
          "payCode": {
            ".write": "auth != null && root.child('shops').child($shopId).child('owners').child(auth.uid).exists()",
            ".validate": "newData.hasChildren(['hash','salt']) && newData.child('hash').isString() && newData.child('hash').val().length === 64 && newData.child('salt').isString() && newData.child('salt').val().length <= 64"
          }
        }
      }
    },
    "accounts": {
      "$uid": {
        "plan":             { ".read": "auth != null",  ".write": false },
        "planExpiry":       { ".read": "auth != null",  ".write": false },
        "paymentFailed":    { ".read": "auth != null",  ".write": false },
        "billingExempt":    { ".read": "auth != null",  ".write": false },
        "cancelAtPeriodEnd":  { ".read": "auth != null",  ".write": false },
        "currentPeriodEnd":   { ".read": "auth != null",  ".write": false },
        "scheduledPlan":      { ".read": "auth != null",  ".write": false },
        "scheduledPlanDate":  { ".read": "auth != null",  ".write": false },
        "stripeCustomerId": { ".read": false, ".write": false },
        "stripeSubscriptionId": { ".read": false, ".write": false },
        "shops": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "company": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      }
    },
    "companies": {
      "$companyId": {
        ".write": false,
        "pub": {
          ".read": "auth != null && (auth.uid === 'company_' + $companyId || data.child('ownerUid').val() === auth.uid)"
        },
        "private": {
          ".read": false,
          ".write": false,
          "payCode": {
            ".read": "auth != null && (auth.uid === 'company_' + $companyId || root.child('companies').child($companyId).child('pub').child('ownerUid').val() === auth.uid)"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "profile": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
          ".validate": "newData.hasChildren(['displayName'])",
          "displayName": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 50" },
          "number": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 8" },
          "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        },
        "seen": {
          "$shopId": {
            "$periodId": {
              ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
              ".validate": "newData.hasChildren(['at'])",
              "at": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "days": {
                "$date": { ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isString() && newData.val().length <= 40" }
              },
              "$other": { ".validate": false }
            }
          }
        },
        "workplaces": {
          "$wid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
            ".validate": "newData.hasChildren(['kind', 'color']) && (($wid.matches(/^m_[A-Za-z0-9]{8}$/) && newData.child('kind').val() === 'manual' && newData.hasChild('name') && !newData.hasChild('shopId')) || (!$wid.matches(/^m_/) && $wid.length <= 128 && newData.child('kind').val() === 'shifty' && newData.child('shopId').val() === $wid))",
            "kind": { ".validate": "newData.isString() && (newData.val() === 'shifty' || newData.val() === 'manual')" },
            "color": { ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)" },
            "name": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30" },
            "shopId": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128" },
            "pay": {
              ".validate": "newData.hasChildren(['closingDay', 'payMonthOffset', 'payDay', 'holidayRule']) && (!newData.hasChild('rate') || newData.hasChild('wageType'))",
              "closingDay": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31" },
              "payMonthOffset": { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2)" },
              "payDay": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31" },
              "holidayRule": { ".validate": "newData.isString() && (newData.val() === 'before' || newData.val() === 'after' || newData.val() === 'none')" },
              "wageType": { ".validate": "newData.isString() && (newData.val() === 'hourly' || newData.val() === 'daily')" },
              "rate": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000" },
              "commute": {
                ".validate": "newData.hasChildren(['amount', 'per'])",
                "amount": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000" },
                "per": { ".validate": "newData.isString() && (newData.val() === 'day' || newData.val() === 'month')" },
                "$other": { ".validate": false }
              },
              "night": { ".validate": "newData.isBoolean()" },
              "over8": { ".validate": "newData.isBoolean()" },
              "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        },
        "goals": {
          ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
          ".validate": "newData.hasChildren(['monthly'])",
          "monthly": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000000" },
          "updatedAt": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "$other": { ".validate": false }
        },
        "actuals": {
          "$ym": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
            "$wid": {
              ".validate": "$ym.matches(/^[0-9]{4}-(0[1-9]|1[0-2])$/) && $wid.length <= 128 && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            }
          }
        },
        "shifts": {
          "$sid": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
            ".validate": "$sid.matches(/^h_[A-Za-z0-9]{10}$/) && newData.hasChildren(['workplaceId', 'date', 'start', 'end', 'breakMin'])",
            "workplaceId": { ".validate": "newData.isString() && newData.val().matches(/^m_[A-Za-z0-9]{8}$/)" },
            "date": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)" },
            "start": { ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-9]):[0-5][0-9]|30:00)$/)" },
            "end": { ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-9]):[0-5][0-9]|30:00)$/)" },
            "breakMin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
            "memo": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "$other": { ".validate": false }
          }
        },
        "overrides": {
          "$shopId": {
            ".write": "auth != null && auth.uid === $uid && auth.token.email != null",
            "$date": {
              ".validate": "$date.matches(/^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && $shopId.length <= 128 && newData.hasChildren(['start', 'end', 'breakMin'])",
              "start": { ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-9]):[0-5][0-9]|30:00)$/)" },
              "end": { ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-9]):[0-5][0-9]|30:00)$/)" },
              "breakMin": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440" },
              "$other": { ".validate": false }
            }
          }
        }
      }
    },
    "companyCodes": { ".read": false, ".write": false },
    "staffPageTokens": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists()) || (data.exists() && !newData.exists() && root.child('shops').child(data.child('shopId').val()).child('owners').child(auth.uid).exists()))",
        ".validate": "$token.matches(/^[A-Za-z0-9]{24}$/) && newData.hasChildren(['shopId','at']) && newData.child('shopId').val() !== 'demo-toriMatsu-v1' && root.child('global').child('shops').child(newData.child('shopId').val()).exists()",
        "shopId": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128" },
        "at": { ".validate": "newData.isString() && newData.val().length <= 40" },
        "$other": { ".validate": false }
      }
    },
    "staffPageData": {
      "$token": {
        ".read": "auth != null && root.child('staffPageTokens').child($token).child('shopId').isString() && root.child('shops').child(root.child('staffPageTokens').child($token).child('shopId').val()).child('staffPages').child($token).child('status').val() === 'approved'",
        ".write": "auth != null && $token.matches(/^[A-Za-z0-9]{24}$/) && root.child('staffPageTokens').child($token).child('shopId').isString() && root.child('shops').child(root.child('staffPageTokens').child($token).child('shopId').val()).child('staffPages').child($token).child('status').val() === 'approved'",
        "workplaces": {
          "$wid": {
            ".validate": "newData.hasChildren(['kind', 'color']) && (($wid.matches(/^m_[A-Za-z0-9]{8}$/) && newData.child('kind').val() === 'manual' && newData.hasChild('name') && !newData.hasChild('shopId')) || (!$wid.matches(/^m_/) && $wid.length <= 128 && newData.child('kind').val() === 'shifty' && newData.child('shopId').val() === $wid))",
            "kind": {
              ".validate": "newData.isString() && (newData.val() === 'shifty' || newData.val() === 'manual')"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().matches(/^#[0-9a-fA-F]{6}$/)"
            },
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 30"
            },
            "shopId": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 128"
            },
            "pay": {
              ".validate": "newData.hasChildren(['closingDay', 'payMonthOffset', 'payDay', 'holidayRule']) && (!newData.hasChild('rate') || newData.hasChild('wageType'))",
              "closingDay": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31"
              },
              "payMonthOffset": {
                ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2)"
              },
              "payDay": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 31"
              },
              "holidayRule": {
                ".validate": "newData.isString() && (newData.val() === 'before' || newData.val() === 'after' || newData.val() === 'none')"
              },
              "wageType": {
                ".validate": "newData.isString() && (newData.val() === 'hourly' || newData.val() === 'daily')"
              },
              "rate": {
                ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000"
              },
              "commute": {
                ".validate": "newData.hasChildren(['amount', 'per'])",
                "amount": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 1000000"
                },
                "per": {
                  ".validate": "newData.isString() && (newData.val() === 'day' || newData.val() === 'month')"
                },
                "$other": {
                  ".validate": false
                }
              },
              "night": {
                ".validate": "newData.isBoolean()"
              },
              "over8": {
                ".validate": "newData.isBoolean()"
              },
              "updatedAt": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "$other": {
                ".validate": false
              }
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "shifts": {
          "$sid": {
            ".validate": "$sid.matches(/^h_[A-Za-z0-9]{10}$/) && newData.hasChildren(['workplaceId', 'date', 'start', 'end', 'breakMin'])",
            "workplaceId": {
              ".validate": "newData.isString() && newData.val().matches(/^m_[A-Za-z0-9]{8}$/)"
            },
            "date": {
              ".validate": "newData.isString() && newData.val().matches(/^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/)"
            },
            "start": {
              ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-9]):[0-5][0-9]|30:00)$/)"
            },
            "end": {
              ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-9]):[0-5][0-9]|30:00)$/)"
            },
            "breakMin": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
            },
            "memo": {
              ".validate": "newData.isString() && newData.val().length <= 200"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "overrides": {
          "$shopId": {
            "$date": {
              ".validate": "$date.matches(/^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) && $shopId.length <= 128 && newData.hasChildren(['start', 'end', 'breakMin'])",
              "start": {
                ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-9]):[0-5][0-9]|30:00)$/)"
              },
              "end": {
                ".validate": "newData.isString() && newData.val().matches(/^(([01][0-9]|2[0-9]):[0-5][0-9]|30:00)$/)"
              },
              "breakMin": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1440"
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "goals": {
          ".validate": "newData.hasChildren(['monthly'])",
          "monthly": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 100000000"
          },
          "updatedAt": {
            ".validate": "newData.isString() && newData.val().length <= 40"
          },
          "$other": {
            ".validate": false
          }
        },
        "actuals": {
          "$ym": {
            "$wid": {
              ".validate": "$ym.matches(/^[0-9]{4}-(0[1-9]|1[0-2])$/) && $wid.length <= 128 && newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000"
            }
          }
        },
        "seen": {
          "$shopId": {
            "$periodId": {
              ".validate": "newData.hasChildren(['at'])",
              "at": {
                ".validate": "newData.isString() && newData.val().length <= 40"
              },
              "days": {
                "$date": {
                  ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/) && newData.isString() && newData.val().length <= 40"
                }
              },
              "$other": {
                ".validate": false
              }
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "staffPagePins": { ".read": false, ".write": false },
    "staffPageEmails": { ".read": false, ".write": false },
    "staffPageEmailIndex": { ".read": false, ".write": false },
    "staffPageEmailRate": { ".read": false, ".write": false }
  }
}
