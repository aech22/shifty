{
  "rules": {
    "global": {
      "shops": {
        "$shopId": {
          ".read": true,
          ".write": "newData.exists() && newData.child('id').val() === $shopId"
        }
      },
      "templates": { ".read": true, ".write": true }
    },
    "tokens": {
      "$token": {
        ".read": true,
        ".write": "!data.exists() || (newData.exists() && newData.child('shopId').val() === data.child('shopId').val())",
        ".validate": "newData.hasChildren(['shopId','periodId'])"
      }
    },
    "shops": {
      "$shopId": {
        ".read": true,
        ".write": true,
        "subs": {
          "$subId": {
            ".validate": "newData.hasChildren(['id','staffName','periodId','shifts','submittedAt']) && newData.child('staffName').isString() && newData.child('staffName').val().length <= 50"
          }
        }
      }
    },
    "accounts": {
      "$uid": {
        "plan":             { ".read": true,  ".write": false },
        "planExpiry":       { ".read": true,  ".write": false },
        "paymentFailed":    { ".read": true,  ".write": false },
        "stripeCustomerId": { ".read": false, ".write": false },
        "shops": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "inviteCode": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid"
        },
        "members": {
          ".read": "auth != null && auth.uid === $uid",
          "$memberId": {
            ".write": "auth != null && auth.uid === $memberId"
          }
        }
      }
    },
    "inviteCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid)"
      }
    }
  }
}
